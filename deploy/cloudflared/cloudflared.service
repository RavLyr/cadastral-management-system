[Unit]
Description=Cloudflare Tunnel (Buku C Digital)
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=root
ExecStart=/usr/local/bin/cloudflared --config /etc/cloudflared/config.yml tunnel run buku-c
Restart=on-failure
RestartSec=5
TimeoutStartSec=0

# Port 8080 (app) harus sudah listen saat tunnel start
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080 >/dev/null; do sleep 2; done'

[Install]
WantedBy=multi-user.target
